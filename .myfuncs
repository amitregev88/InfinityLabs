#
# gcc compilation aliases: c89, c99, debug mode, release mode
alias gd='gcc -ansi -pedantic-errors -Wall -Wextra -g'
alias gc='gcc -ansi -pedantic-errors -Wall -Wextra -DNDEBUG -03'
alias gd9='gcc -std=c99 -pedantic-errors -Wall -Wextra -g' 
alias gc9='gcc -std=c99 -pedantic-errors -Wall -Wextra -DNDEBUG -03'

#without linking
alias gob='gcc -c'
 #
# Valgrind alias
 alias vlg='valgrind --leak-check=yes --track-origins=yes'
 
 # nice alias

 alias dragon='fortune | cowsay -f dragon| lolcat'
 
 
 # C++ Compilation aliases:
alias gd+='g++ -std=c++11 -pedantic-errors -Wall -Wextra -g'
alias cpr1='g++ -std=c++11 -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
alias cpd8='g++ -std=c++98 -pedantic-errors -Wall -Wextra -g'
alias pc8='g++ -std=c++98 -pedantic-errors -Wall -Wextra -DNDEBUG -O3'
alias cpd1nw='g++ -std=c++11 -Wall -Wextra -g'
alias cpd8nw='g++ -std=c++98 -Wall -Wextra -g'
#



